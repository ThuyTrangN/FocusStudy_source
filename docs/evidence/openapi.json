  "components": {
    "schemas": {
      "Auth": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "title": "Name",
            "default": "Sinh viên"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Auth"
      },
      "Calibrate": {
        "properties": {
          "branch": {
            "type": "string",
            "title": "Branch"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "target": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target"
          }
        },
        "type": "object",
        "required": [
          "branch",
          "action"
        ],
        "title": "Calibrate"
      },
      "Command": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "prompt_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt Id"
          },
          "expected_state_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expected State Version"
          }
        },
        "type": "object",
        "required": [
          "type"
        ],
        "title": "Command"
      },
      "Feedback": {
        "properties": {
          "prompt_id": {
            "type": "string",
            "title": "Prompt Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "rating": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 5.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          }
        },
        "type": "object",
        "required": [
          "prompt_id",
          "action"
        ],
        "title": "Feedback"
      },
      "Frame": {
        "properties": {
          "image": {
            "type": "string",
            "maxLength": 3000000,
            "title": "Image"
          },
          "frame_id": {
            "type": "integer",
            "title": "Frame Id"
          },
          "state_version": {
            "type": "integer",
            "title": "State Version"
          }
        },
        "type": "object",
        "required": [
          "image",
          "frame_id",
          "state_version"
        ],
        "title": "Frame"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "NewSession": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Goal"
          },
          "duration_minutes": {
            "type": "integer",
            "maximum": 240.0,
            "minimum": 1.0,
            "title": "Duration Minutes",
            "default": 25
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "reading"
          },
          "condition": {
            "type": "string",
            "title": "Condition",
            "default": "B"
          },
          "document_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Document Id"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "goal"
        ],
        "title": "NewSession"
      },
      "Profile": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Profile"
      },
      "Rating": {
        "properties": {
          "prompt_id": {
            "type": "string",
            "title": "Prompt Id"
          },
          "rating": {
            "type": "boolean",
            "title": "Rating"
          }
        },
        "type": "object",
        "required": [
          "prompt_id",
          "rating"
        ],
        "title": "Rating"
      },
      "SessionDocument": {
        "properties": {
          "document_id": {
            "anyOf": [
              {
